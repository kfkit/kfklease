# The stand's constants that more than its bash scripts read: compose.yaml
# interpolates them (compose reads the .env next to its file by itself),
# lib.sh sources them and the Makefile includes them. Three parsers, so
# plain NAME=value lines only: no quotes, no spaces, no references.
# Test values of a throwaway broker; nothing here is a secret.
#
# The certs service keeps what it wrote: after a change of the address or
# of the SASL user, remove .out/certs.

COMPOSE_PROJECT_NAME=kfklease-e2e

# The broker on the kfk network, where pods reach it: plaintext, SASL and
# mTLS. The address lies in the subnet compose.yaml gives that network.
KAFKA_ADDR=172.30.0.10
KAFKA_PORT=9092
KAFKA_SASL_PORT=9094
KAFKA_MTLS_PORT=9095
# The same three listeners on the host's localhost, for `make integration`.
KAFKA_HOST_PORT=19092
KAFKA_HOST_SASL_PORT=19094
KAFKA_HOST_MTLS_PORT=19095

# The broker's SASL PLAIN user.
SASL_USER=kfklease
SASL_PASSWORD=kfklease-secret

# What build-image.sh builds; the scaler's is also what `make image` builds.
SCALER_IMAGE=kfklease-scaler:dev
HEARTBEAT_IMAGE=kfklease-heartbeat:dev
